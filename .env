# ==============================================
# StudyBuddy AI - Environment Configuration
# ==============================================
# SECURITY WARNING: This file contains sensitive information
# - Never commit real API keys or secrets to version control
# - Use a separate .env file for each environment
# - Store production secrets in a secure secret manager

# ==============================================
# ENVIRONMENT & SERVER
# ==============================================
NODE_ENV=development
PORT=5000

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Local MongoDB (Development)
MONGODB_URI=mongodb://localhost:27017/studybuddy

# Production MongoDB Atlas (uncomment for production)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/studybuddy?retryWrites=true&w=majority

# ==============================================
# REDIS CONFIGURATION
# ==============================================
# Local Redis (Development)
REDIS_URL=redis://localhost:6379

# Production Redis (uncomment for production)
# REDIS_URL=rediss://username:password@hostname:port/0

# ==============================================
# SECURITY CONFIGURATION
# ==============================================
# CRITICAL: Generate secure random strings for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# JWT Configuration
JWT_SECRET=a1b2c3d4e5f6789012345678901234567890123456789012345678901234567890123456789012345678901234567890
JWT_EXPIRES_IN=24h

# Session Configuration
SESSION_SECRET=s1e2s3s4i5o6n789012345678901234567890123456789012345678901234567890123456789012345678901234567890

# Password Hashing
BCRYPT_ROUNDS=12

# ==============================================
# AI API CONFIGURATION
# ==============================================
# Anthropic API (Primary AI provider for server.js)
ANTHROPIC_API_KEY=sk-ant-api03-development-placeholder-key-replace-with-real-key

# Google Gemini API (Alternative/Additional AI provider)
GEMINI_API_KEY=YOUR_GOOGLE_API_KEY_HERE

# OpenAI API (Optional)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# ==============================================
# CORS & SECURITY
# ==============================================
# Development origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000

# Production origins (uncomment and modify for production)
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Request Configuration
MAX_REQUEST_SIZE=10mb

# ==============================================
# RATE LIMITING
# ==============================================
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ==============================================
# LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
# Gmail SMTP (for notifications and password reset)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# Alternative SMTP providers:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_HOST=smtp.mailgun.org

# ==============================================
# FILE UPLOAD CONFIGURATION
# ==============================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=pdf,txt,doc,docx,png,jpg,jpeg

# ==============================================
# FEATURE FLAGS
# ==============================================
ENABLE_CLUSTERING=false
ENABLE_VOICE_FEATURES=true
ENABLE_FILE_UPLOAD=true
ENABLE_REAL_TIME_COLLABORATION=true
ENABLE_ANALYTICS=true
ENABLE_PUSH_NOTIFICATIONS=false

# ==============================================
# CACHING CONFIGURATION
# ==============================================
CACHE_TTL=3600

# ==============================================
# EXTERNAL SERVICES
# ==============================================
# Error Tracking (Sentry)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Analytics
ANALYTICS_ID=your-google-analytics-id

# Speech Services (Optional)
SPEECH_TO_TEXT_API_KEY=your-speech-to-text-key
TEXT_TO_SPEECH_API_KEY=your-text-to-speech-key

# ==============================================
# BACKUP CONFIGURATION
# ==============================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

# ==============================================
# DEVELOPMENT/DEBUG OPTIONS
# ==============================================
# Set to true to enable debug logging in development
DEBUG_MODE=false

# Mock external APIs in development
MOCK_AI_RESPONSES=false

# Database query logging
LOG_DATABASE_QUERIES=false


