# ChaseJEE Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/chasejee

# Authentication Secrets (Generate strong random strings)
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random
SESSION_SECRET=your-session-secret-here-also-make-it-long-and-random

# AI API Keys (Get these from respective providers)
OPENAI_API_KEY=sk-your-openai-api-key-here
GOOGLE_API_KEY=your-google-gemini-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Email Configuration (Optional - for user notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Redis Configuration (Optional - for session storage)
REDIS_URL=redis://localhost:6379

# Security Configuration
CORS_ORIGIN=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=10m
LOG_FILE_MAX_FILES=5d

# Feature Flags
ENABLE_SPEECH_TO_TEXT=true
ENABLE_ANALYTICS_EXPORT=true
ENABLE_QUIZ_HISTORY=true
ENABLE_ACHIEVEMENTS=true
