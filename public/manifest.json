  "screenshots": [
    {
      "src": "/screenshots/desktop-screenshot.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide"
    },
    {
      "src": "/screenshots/mobile-screenshot.png",
      "sizes": "390x844",
      "type": "image/png",
      "form_factor": "narrow"
    }
  ],
  "shortcuts": [
    {
      "name": "Start AI Chat",
      "short_name": "Chat",
      "description": "Start a conversation with StudyBuddy AI",
      "url": "/#chat",
      "icons": [
        {
          "src": "/icons/chat-icon.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Take Quiz",
      "short_name": "Quiz",
      "description": "Start a practice quiz",
      "url": "/#quiz",
      "icons": [
        {
          "src": "/icons/quiz-icon.png",
          "sizes": "96x96"
        }
      ]
    },
    {
      "name": "Study Timer",
      "short_name": "Timer",
      "description": "Start a Pomodoro study session",
      "url": "/#study-timer",
      "icons": [
        {
          "src": "/icons/timer-icon.png",
          "sizes": "96x96"
        }
      ]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["text/plain", ".pdf", ".doc", ".docx"]
        }
      ]
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+studybuddy",
      "url": "/app?question=%s"
    }
  ],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  }
}